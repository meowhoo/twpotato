upstream/
# Build output
target/
# Full Codex run logs; the review results are kept as .md
plans/reviews/*.log
train/.venv/
__pycache__/
# Model weights and packed tables stay out of git unless added deliberately
*.npz
*.pack
/ime/target-norm/
target-*/
# Codex review completion markers
plans/reviews/.*.done

# Article collector (collect/): dependencies, logs and process files stay local
/collect/node_modules/
/collect/*.log
/collect/*-process.json

# Local backups made before edits
*.pre-*

# RELEASE build outputs (MSI, staging; large, never committed)
release/out/

# RELEASE P4: stages, settings-app build output, installers, secrets
ime/stage-*/
ime/settings-app/node_modules/
ime/settings-app/dist/
ime/settings-app/src-tauri/gen/
*.msi
*.wixpdb
*.cab
*.jsonl
*.pfx
*.p12
*.snk
.env

# Backups / build outputs / binaries (never committed)
*.old-install
*.gpu*-patch
/ime/target*/
/ime/stage*/
*.exe
*.dll
*.bin
*.twg*
*.fst
*.lst
*.log
