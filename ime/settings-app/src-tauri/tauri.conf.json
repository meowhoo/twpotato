{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "地瓜輸入法",
  "version": "0.1.9",
  "identifier": "tw.twime.settings",
  "build": { "frontendDist": "../dist" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "地瓜輸入法 設定", "width": 820, "height": 600, "minWidth": 620, "minHeight": 440 }],
